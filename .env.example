# Copy this file to .env.local for local development. Never commit real values.

# --- Website (Next.js / Vercel) ---------------------------------------------
# Float's OWN Convex deployment URL (not Staff's, the Hub's or MealSync's).
NEXT_PUBLIC_CONVEX_URL=

# Used by `npx convex dev` / `npx convex deploy`. For deploying from Vercel,
# set FLOAT_CONVEX_DEPLOY_KEY (Float's production deploy key) in Vercel instead.
CONVEX_DEPLOYMENT=
# Deploy key: set FLOAT_CONVEX_DEPLOY_KEY in your environment (never in this file).
# Scripts map it to CONVEX_DEPLOY_KEY only while a command runs.

# --- Set on Float's Convex deployment (dashboard -> Settings -> Environment
# Variables, or `npx convex env set NAME value`), NOT in this file ----------
# SITE_URL              The website address, e.g. https://float.livoza.org
# JWT_PRIVATE_KEY, JWKS Login signing keys (created automatically by the Vercel build)
# SEED_ADMIN_NAME       The first admin's name,
# SEED_ADMIN_PHONE      mobile number
# SEED_ADMIN_PASSWORD   and password (remove it once the admin exists).
# HUB_SSO_PUBLIC_KEY    The Admin Hub's public key (single sign-on)
# HUB_ORIGIN            The Admin Hub's address, e.g. https://admin.livoza.org
# HUB_ONLY              "true" once everyone signs in through the Livoza Hub: this app's own
#                       sign-in is switched off and sends people to the hub.
